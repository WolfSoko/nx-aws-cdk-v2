{
  "workspaceLayout": {
    "appsDir": "e2e",
    "libsDir": "packages"
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.[jt]s",
      "!{projectRoot}/tsconfig.*spec.json",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/src/*test-setup.[jt]s",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/eslint.config.js"
    ],
    "globals": [],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/ci.yml"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "e2e": {
      "dependsOn": ["aws-cdk-v2:build"],
      "cache": true
    },
    "e2e-ci--**/*": {
      "dependsOn": ["aws-cdk-v2:build"],
      "cache": true
    },
    "@nx/jest:jest": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/jest.preset.js"],
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/packages/{projectName}"
      }
    }
  },
  "parallel": 1,
  "useInferencePlugins": true,
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": ["packages/aws-cdk-v2/**/*"]
    },
    {
      "plugin": "@nx/jest/plugin",
      "include": ["e2e/**/*"],
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci",
        "runInBand": true
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": ["**/*"]
    }
  ],
  "release": {
    "projects": ["aws-cdk-v2"],
    "releaseTag": {
      "pattern": "{version}"
    },
    "version": {
      "conventionalCommits": true
    },
    "conventionalCommits": {
      "types": {
        "feat": { "semverBump": "minor" },
        "fix": { "semverBump": "patch" },
        "perf": { "semverBump": "patch" },
        "revert": { "semverBump": "patch" },
        "refactor": { "semverBump": "none" },
        "docs": { "semverBump": "none" },
        "style": { "semverBump": "none" },
        "test": { "semverBump": "none" },
        "build": { "semverBump": "none" },
        "ci": { "semverBump": "none" },
        "chore": { "semverBump": "none" },
        "sample": { "semverBump": "none" }
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github",
        "file": false
      }
    }
  },
  "nxCloudId": "671a4aa0e85b0ab04b22bbf3"
}
