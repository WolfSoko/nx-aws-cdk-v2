{
  "name": "@wolsok/nx-aws-cdk-v2",
  "description": "nx aws-cdk-v2 plugin",
  "author": {
    "name": "Wolfram Sokollek",
    "email": "wolframsokollek+github@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://angularexamples.wolsok.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolfSoko/nx-aws-cdk-v2"
  },
  "scripts": {
    "nx": "nx",
    "lint-stage": "lint-staged",
    "commitlint": "commitlint",
    "test": "npx nx test aws-cdk-v2",
    "lint": "npx nx lint aws-cdk-v2",
    "format": "npx nx format:write",
    "e2e:aws-cdk": "npx nx e2e aws-cdk-v2-e2e",
    "build:aws-cdk": "npx nx build aws-cdk-v2",
    "link:aws-cdk": "cd dist/packages/aws-cdk-v2 && npm link"
  },
  "private": true,
  "dependencies": {
    "aws-cdk": "2.1137.0",
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2201.4",
    "@angular-devkit/core": "21.2.21",
    "@angular-devkit/schematics": "21.2.21",
    "@commitlint/cli": "21.2.2",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "~10.0.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/plugin": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.0",
    "@swc/helpers": "0.5.23",
    "@types/jest": "30.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "dotenv": "17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-json": "^5.0.0",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.2.0",
    "nx": "23.1.1",
    "nx-cloud": "19.1.3",
    "prettier": "3.9.6",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "files": [
    "src/*",
    "cli/*",
    "lib/*",
    "peers/*",
    "scripts/*.js",
    "stubs/*.stub.js",
    "nesting/*",
    "types/**/*",
    "*.d.ts",
    "*.css",
    "*.js"
  ],
  "lint-staged": {
    "*.{js,json,css,scss,md,ts,html,graphql}": [
      "npm run format --uncommitted"
    ]
  }
}
